# Deny everything, then admit only source and reviewed build configuration.
**
!pyproject.toml
!LICENSE
!src/
!src/workflow_doctor/
!src/workflow_doctor/*.py
!src/workflow_doctor/api/
!src/workflow_doctor/api/*.py
!src/workflow_doctor/api/assets/
!src/workflow_doctor/api/assets/swagger-ui-bundle.js
!src/workflow_doctor/api/assets/swagger-ui.css
!src/workflow_doctor/api/assets/LICENSE.txt
!src/workflow_doctor/api/assets/swagger-ui-bundle.js.LICENSE.txt
!deploy/
!deploy/backend/
!deploy/backend/Dockerfile
!deploy/backend/requirements.lock
!deploy/backend/build.lock
!deploy/frontend/
!deploy/frontend/Dockerfile
!deploy/frontend/*.conf
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**/
!frontend/src/**/*.ts
!frontend/src/**/*.vue
!frontend/src/**/*.css
# Keep sensitive and local files excluded even inside an admitted source folder.
**/.env*
**/*.local.*
**/*.json
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
**/node_modules/**
**/__pycache__/**
**/private/**
**/uploads/**
**/secrets/**
**/credentials/**
