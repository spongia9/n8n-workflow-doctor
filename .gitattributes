* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
/frontend/index.html text eol=lf
*.conf text eol=lf
*.lock text eol=lf
/deploy/**/Dockerfile text eol=lf
/.dockerignore text eol=lf
/docs/images/*.png -text
# Preserve exact fixture/report JSON bytes in Git as well as in the scanner.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve audited upstream documentation asset hashes.
/src/workflow_doctor/api/assets/* -text -whitespace
