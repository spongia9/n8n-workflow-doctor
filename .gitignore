# Workflow exports and JSON reports are private by default. Only reviewed,
# fabricated fixtures and generated synthetic examples belong in version control.
*.json
!tests/fixtures/valid.json
!tests/fixtures/missing_target.json
!tests/fixtures/invalid.json
!tests/fixtures/duplicate_id.json
!tests/fixtures_compat/synthetic_export_shape.json
!examples/sprint2/workflows/A.json
!examples/sprint2/workflows/B.json
!examples/sprint2/workflows/C.json
!examples/sprint2/workflows/ERROR_HANDLER.json
!examples/sprint2/migration-report.json
!examples/sprint2/dependency-graphs.json
