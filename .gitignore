!examples/sprint2-formal/workflows/B.json
!examples/sprint2-formal/workflows/C.json
!examples/sprint2-formal/workflows/ERROR_HANDLER.json
!examples/sprint2-formal/migration-report.json
!examples/sprint2-formal/dependency-graphs.json
!examples/sprint3/migration-report.json
*.html
!examples/sprint3/migration-report.html
!examples/sprint3/structural-report.html

